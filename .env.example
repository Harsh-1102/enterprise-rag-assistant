# ==============================================================================
# Enterprise Document Intelligence & RAG Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your real Google Gemini API Key:
# cp .env.example .env
#
# Get your Gemini API key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# ==============================================================================

# Gemini API Key (Required for online LLM answer generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini model name (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Embedding model name (defaults to all-MiniLM-L6-v2)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: Default chunk size and overlap
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Optional: Top-K retrieved chunks
TOP_K=4

# Optional: Similarity distance threshold for FAISS (L2 distance or cosine score)
SIMILARITY_THRESHOLD=0.35
